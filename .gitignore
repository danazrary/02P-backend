# Node modules
node_modules/

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Directory for instrumented libs generated by jscoverage/JSCover
lib-cov

# Coverage directory used by tools like istanbul
coverage/
*.lcov

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# dotenv environment variables file
.env
.env.local
.env.*.local
.env.http
.env.https
.env.production  # Production secrets - NEVER commit
.env.production.example  # Example production secrets - safe to commit

# Mac system files
.DS_Store

# VSCode settings
.vscode/

# npm package lock
package-lock.json
yarn.lock

# Build directories
dist/

# Uploaded files - ignore contents but keep folder structure
uploads/**/*
!uploads/**/.gitkeep
build/

# Temporary files
tmp/
temp/

# IDE/editor folders
.idea/
*.sublime-project
*.sublime-workspace
